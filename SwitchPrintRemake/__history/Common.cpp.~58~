// 실제 출력 담당
void PrintBarcode()
{
	OutputDebugString(L"바코드 프린팅..\n");

	Zebra_Init(PrintForm->ComPort1, PrintForm->TempEdit->Value);




	AnsiString Barcode_Data, Barcode_Data1, Barcode_Data2, Barcode_Data3;
	char* date;
	AnsiString Date;

	unsigned short Year, Month, Day;
	unsigned short Hour, Minute, Second, mSecond;

	Now().DecodeDate(&Year, &Month, &Day);
	Now().DecodeTime(&Hour, &Minute, &Second, &mSecond);

	Date = Date.sprintf("%02d%02d%02d", Year - 2000, Month, Day);

    date = Date.c_str();


	Barcode_Data = "";
	Barcode_Data.sprintf
	(
		"[)>06V%sP%s",
		Barcode_Spec.Company,
		Barcode_Spec.Part_Number
	);

	if(strlen(Barcode_Spec.Alc)) Barcode_Data1.sprintf("S%s", Barcode_Spec.Alc);
	if(strlen(Barcode_Spec.Eo)) Barcode_Data2.sprintf("E%s", Barcode_Spec.Eo);



	// BARCODE COUNT(SERIAL)
	TIniFile *Count_File = new TIniFile(COUNT_FILE);

	int Count;


	/*
	// 혅재 부품 번호 기준으로 하였음(모델 이름이 아님)
	Count = Count_File->ReadInteger("BARCODE", PrintForm->Part_Number_Panel->Text + Date, 0) + 1;
	*/

	Count = Count_File->ReadInteger("BARCODE", PrintForm->Model_Name_Panel->Caption + Date, 0) + 1;
	Count_File->WriteInteger("BARCODE", PrintForm->Model_Name_Panel->Caption + Date, Count);


	Barcode_Data3.sprintf("T%s%s%s%07d", date, Barcode_Spec.Product_4M, Barcode_Spec.Lot, 10000 + Count); // Serial : 10000 + n

	Barcode_Data = Barcode_Data + Barcode_Data1 + Barcode_Data2 + Barcode_Data3;

	// 출력 결과 보여주기 텍스트 출력
	AnsiString WatchLog;
	WatchLog = FormatDateTime("YYYY-MM-DD HH:NN:SS", Now());
	WatchLog += " | ";
	WatchLog += Barcode_Data;

	PrintForm->UIText->Lines->Add(WatchLog);



	Zebra_Barcode_DataMatrix
	(
		PrintForm->ComPort1,
		Barcode_Data, //"06VRNQYP93575P9000SS170T260203A1B1A0010003",
		StrToIntDef(PrintForm->XEdit->Text, 0),
		StrToIntDef(PrintForm->YEdit->Text, 0),
		(int)PrintForm->SizeEdit->Value
	);


	Zebra_Execute(PrintForm->ComPort1);

}