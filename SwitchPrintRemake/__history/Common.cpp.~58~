void Recent_Model_Save(AnsiString FileName)
{
	TIniFile *System_File = new TIniFile(SYSTEM_FILE);

	System_File->WriteString("RECENT", "MODEL", FileName);

	delete(System_File);
}

AnsiString Recent_Model_Open()
{
	AnsiString FileName;

	TIniFile *System_File = new TIniFile(SYSTEM_FILE);

	FileName = System_File->ReadString("RECENT", "MODEL", "");

	delete(System_File);

	return FileName;
}

void Model_Save(AnsiString FilePath)
{
	AnsiString Str;

	FILE *fp;

	fp = fopen(FilePath.c_str(), "wb");

	if(fp == NULL)
	{
		ShowMessage("없대");
		return;
	}

	__BARCODE_SPEC Barcode_Spec;

	memset(&Barcode_Spec, 0, sizeof(Barcode_Spec));

	AnsiString Model_Name = ExtractFileName(FilePath);
	Model_Name.Delete(Model_Name.Pos(".spc"), 4);

	PrintForm->Model_Name_Panel->Caption = Model_Name;

	strcpy(Barcode_Spec.Company, ((AnsiString)(PrintForm->Company_Panel->Text)).c_str());
	strcpy(Barcode_Spec.Part_Number, ((AnsiString)(PrintForm->Part_Number_Panel->Text)).c_str());
	strcpy(Barcode_Spec.Alc, ((AnsiString)(PrintForm->Alc_Panel->Text)).c_str());
	strcpy(Barcode_Spec.Eo, ((AnsiString)(PrintForm->EO_Panel->Text)).c_str());
	strcpy(Barcode_Spec.Product_4M, ((AnsiString)(PrintForm->Product_4M_Panel->Text)).c_str());
	strcpy(Barcode_Spec.Lot, ((AnsiString)(PrintForm->Lot_Panel->Text)).c_str());

	fwrite(&Barcode_Spec, sizeof(Barcode_Spec), 1, fp);

	fclose(fp);

	Recent_Model_Save(FilePath);

}

void Model_Open(AnsiString FilePath)
{
	FILE *fp;

	fp = fopen(FilePath.c_str(), "rb");

	if(fp == NULL)
	{
		ShowMessage("SPEC FILE OPEN ERROR");
		return;
	}

	__BARCODE_SPEC Barcode_Spec;

	memset(&Barcode_Spec, 0, sizeof(Barcode_Spec));
	fread(&Barcode_Spec, sizeof(Barcode_Spec), 1, fp);

	fclose(fp);

	AnsiString Model_Name = ExtractFileName(FilePath);
	Model_Name.Delete(Model_Name.Pos(".spc"), 4);

	PrintForm->Model_Name_Panel->Caption = Model_Name;


	PrintForm->Company_Panel->Text = Barcode_Spec.Company;
	PrintForm->Part_Number_Panel->Text = Barcode_Spec.Part_Number;
	PrintForm->Alc_Panel->Text = Barcode_Spec.Alc;
	PrintForm->EO_Panel->Text = Barcode_Spec.Eo;
	PrintForm->Product_4M_Panel->Text = Barcode_Spec.Product_4M;
	PrintForm->Lot_Panel->Text = Barcode_Spec.Lot;

	Recent_Model_Save(FilePath);
}

void Barcode_Model_Open(AnsiString FilePath)
{
	FILE *fp;

	AnsiString Str;
	unsigned short Year, Month, Day;

	fp = fopen(FilePath.c_str(), "rb");

	if(fp == NULL)
	{
		ShowMessage("SPEC FILE OPEN ERROR");
