int Card_7230;

/*
	== 알게 된 것들 ==


  PROGRAM_TEST 로 감싸는 이유:  장비 없이 테스트 하기 위한 제어용 상수를 만드는 것임
  convert-pic.lib 나 pdask_bc.lib 중 ADLINK의 Card_7230을 제어하기 위한 라이브러리가 있는 것 같다. ( + Dask.h)

  매번 카드가 잘 초기화 되었는지, 값이 있는지 체크하는 조건을 둔다. 정확한 제어가 필수

  비트 연산에 16진수 0x??을 사용하며 0000 0000 (2진수)에서 0x01은 비트 연산할때 유용하다.
  비트 연산자 & (둘다 참), | (둘 중 하나라도 참),  >> (오른쪽으로 밀기) , << (왼쪽으로 밀기)

  FindComponent("스트링값") 을 통해 해당 참조값을 가져올 수 있다.

  String.Substring(시작번호, 끝번호) 는 끝번호가 넘쳐흘러도 시작번호가 잘못된 값이 아니면 오류없이 가져온다.

  Var.h 에다가 공용변수나 상수 값 저장해 두는 듯


  - 라이브러리 함수

	Register_Card(ADLINK PCI카드번호, 값) : 카드를 값 으로 초기화
	Release_Card(카드 번호) : 카드에 해당하는 I/O보드 해제
	DIReadPort(카드 번호, 포트번호, 배열주소) : 카드의 해당 포트 값들을 읽어와 배열에 대입한다.
	DOWritePort(카드 번호, 포트번호, 16진수값(U32)) : 카드의 해당 포트 값을 16진수값으로 쓰기한다.
	memset(배열주소, 초기화값, 개수) : 배열중 개수만큼 값을 초기화값으로 초기화

	IO_Close() : IO 완전 종료


	*라이브러리는 사용불가할 경우 C:\Users\Public\Documents\RAD Studio\9.0\ 에서 찾을 수 있었다.

*/







void Io_Init()
{
	Card_7230 = -1; // 카드 -1(초기화 되지않음 표기)

	Card_7230 = Register_Card(PCI_7230, 0);    // 카드 값 0으로 초기화

	if(Card_7230 < 0){ // 값이 초기화 되지 않으면
		ShowMessage("카드 값이 초기화 되지 않았습니다.");
		return;
	}

    ShowMessage("초기화 되지 않았습니다.");

	Output_Init();
}

void Io_Close()
{
	Output_Init();

	Release_Card(Card_7230); // I/O보드 완전 해제
}


#pragma region 입력_영역

void Input_Check()
{
	U32 DIValue = 0x00;

	if(Card_7230 >= 0)
		DI_ReadPort(Card_7230, 0, &DIValue);
		// 카드 초기화 되어있으면 현 카드값 DIValue에 넣어주기)

	for(int i = 0; i < MAX_INPUT_COUNT; i++)
	{
		if(DIValue & (0x01 << i))  // &은 둘다 참이어야 참(1) 반환, 비트 이동하면서 한자리씩 참인지 체크
			Input_Data[i] = true;
		else
			Input_Data[i] = false;
	}
}

#pragma endregion 입력_영역


#pragma region 결과_영역

// 결과값 초기화
void Output_Init()
{
	memset(&Output_Data, 0, sizeof(Output_Data));

	Output_IO();
}

// 결과값 입력
void Output_IO()
{
	U32 DoValue = 0x00;

	for(int i = 0; i < MAX_OUTPUT_COUNT; i++)
		if(Output_Data[i])
			DoValue = DoValue | (0x01 << i);
			// 초기화된 상태면 비트를 << (왼쪽)방향으로 i만큼 밀기
			// |는 둘중(0,1) 하나라도 참이면 참(1)을 반환하는 비트연산자

	if(Card_7230 >= 0)
		DO_WritePort(Card_7230, 0, DoValue);
		// Digital 출력 Port 값 입력 함수: DO_WritePort(보드번호, DO 포트 번호, 출력할 비트);

}

#pragma endregion 결과_영역


#pragma region 출력_과정

bool Output_Process(int Output_Number, bool OnOff)
{
	Input_Check();

	Output_Data[Output_Number] = OnOff;

	Output_IO();

	return true;
}

#pragma endregion 출력_과정



void __fastcall TIOForm::FormCreate(TObject *Sender)
{
	Io_Init();
}
//---------------------------------------------------------------------------
void __fastcall TIOForm::TimerTimer(TObject *Sender)
{
	Timer->Enabled = false;

	Input_Check();

	for(int i = 0; i < MAX_INPUT_COUNT; i++)
	{
		TcyLed* Led = (TcyLed *)FindComponent("InputLed" + IntToStr(i + 1));
		if(Led != NULL) Led->LedValue = Input_Data[i];
	}

	for(int i = 0; i < MAX_OUTPUT_COUNT; i++)
	{
		TcyLed* Led = (TcyLed *)FindComponent("OutputLed" + IntToStr(i + 1));
		if(Led != NULL) Led->LedValue = Output_Data[i];
	}
/*

	AnsiString s = "";
	for(int i = 0; i < MAX_INPUT_COUNT; i++)
	{
		s += Input_Data[i] ? "1" : "0";
	}
	OutputDebugStringA(s.c_str());

*/
	Timer->Enabled = true;
}
//---------------------------------------------------------------------------

void __fastcall TIOForm::Output_Led_Click(TObject *Sender)
{
	int Number = ((TcyLed *)Sender)->Name.SubString(strlen("OutputLed") + 1, 2).ToInt() - 1;

	Output_Process(Number, ((TcyLed *)Sender)->LedValue);
}
//---------------------------------------------------------------------------

void __fastcall TIOForm::FormClose(TObject *Sender, TCloseAction &Action)
{
	Timer->Enabled = false;

	Io_Close();

	Action = caFree;
}
