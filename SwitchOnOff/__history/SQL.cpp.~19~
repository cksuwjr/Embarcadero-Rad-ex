#pragma package(smart_init)

void Send_SQL(AnsiString str)
{

	OutputDebugStringA(str.c_str());


	PrintForm->ADOQuery1->Active = false;
	PrintForm->ADOQuery1->SQL->Clear();
	PrintForm->ADOQuery1->SQL->Add(str);


	if(str.Pos("insert") ||str.Pos("update") || str.Pos("alter") || str.Pos("delete"))
		PrintForm->ADOQuery1->ExecSQL();
	else
		PrintForm->ADOQuery1->Active = true;

}

void SQL_Data_Save()
{
	AnsiString Str, Data, Now_Date_Time;

	Now_Date_Time = DateTimeToStr(Now());

	Str = "insert into new_table values (NULL, ";

	Str += "'";
	Str += PrintForm->Part_Number_Panel->Text;
	Str += "',";

	Str += "'";
	Str += Now_Date_Time;
	Str += "',";

	Str += "'";
	Str += PrintForm->BarcodeRead->Text;
	Str += "')";

	Send_SQL(Str);
}


