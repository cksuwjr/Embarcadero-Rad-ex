void Send_SQL(AnsiString str)
{

	OutputDebugStringA(str.c_str());


	PrintForm->ADOQuery1->Active = false;
	PrintForm->ADOQuery1->SQL->Clear();
	PrintForm->ADOQuery1->SQL->Add(str);

	bool SQL_Result = true;

	if(str.Pos("insert") ||str.Pos("update") || str.Pos("alter") || str.Pos("delete"))
	{
		try
		{
			PrintForm->ADOQuery1->ExecSQL();
		}
		catch(Exception &e)
		{
			SQL_Result = false;
		}
	}
	else
		PrintForm->ADOQuery1->Active = true;

	if(SQL_Result)
		PrintForm->BarcodeRead->Text = "";

	PrintForm->BarcodeRead->SetFocus();

}

void SQL_Data_Save()
{
	AnsiString Str, Data, Now_Date_Time;

	Now_Date_Time = FormatDateTime("yyyy-mm-dd hh:nn:ss", Now());

	Str = "insert into ipsw.new_table (NO, MODEL_NAME, TIME, BARCODE) values (NULL, ";

	Str += "'";
	Str += PrintForm->Model_Name_Panel->Caption;
	Str += "',";

	Str += "'";
	Str += Now_Date_Time;
	Str += "',";

	Str += "'";
	Str += PrintForm->BarcodeRead->Text;
	Str += "')";

	Send_SQL(Str);
}

void Load_SQL()
{
	AnsiString Str;

	Str = "select NO, MODEL_NAME, TIME, BARCODE from ipsw.new_table";




	PrintForm->AdvStringGrid1->Cells[0][0] = "NO";
	PrintForm->AdvStringGrid1->Cells[1][0] = "MODEL_NAME";
	PrintForm->AdvStringGrid1->Cells[2][0] = "TIME";
	PrintForm->AdvStringGrid1->Cells[3][0] = "BARCODE";


     // 컬럼 수 자동
	int colCount = PrintForm->ADOQuery1->FieldCount;
	PrintForm->AdvStringGrid1->ColCount = colCount;

	// 헤더 자동 설정
	for (int c = 0; c < colCount; c++)
	{
		PrintForm->AdvStringGrid1->Cells[c][0] =
			PrintForm->ADOQuery1->Fields->Fields[c]->FieldName;
	}

	int row = 1;

	PrintForm->AdvStringGrid1->BeginUpdate();

	while (!PrintForm->ADOQuery1->Eof)
	{
		PrintForm->AdvStringGrid1->RowCount++;

		for (int c = 0; c < colCount; c++)
		{
			TField *field = PrintForm->ADOQuery1->Fields->Fields[c];
			PrintForm->AdvStringGrid1->Cells[c][row] =
			if (field->IsNull)
				AdvStringGrid1->Cells[c][row] = "";
			else
				AdvStringGrid1->Cells[c][row] = field->AsString;
		}

        row++;
		PrintForm->ADOQuery1->Next();
    }

	PrintForm->AdvStringGrid1->EndUpdate();
	PrintForm->AdvStringGrid1->AutoSizeColumns();


	/*
	PrintForm->ADOQuery1->Active = true;
	PrintForm->AdvStringGrid1->Cells[0][row] = PrintForm->ADOQuery1->Active = true;*/
}
