__fastcall TPrintForm::SetCheckBoxOptionVisible(AnsiString CheckBoxString, bool SetVisible)
{
	TEdit* X = (TEdit *)FindComponent(CheckBoxString + "_X");
	TEdit* Y = (TEdit *)FindComponent(CheckBoxString + "_Y");
	TsDecimalSpinEdit* Size = (TsDecimalSpinEdit *)FindComponent(CheckBoxString + "_Size");


	if(SetVisible)
	{
		X->Visible = true;
		Y->Visible = true;
		Size->Visible = true;
	}
	else
	{
		X->Visible = false;
		Y->Visible = false;
		Size->Visible = false;
	}
}

#pragma endregion __직접 정의__






