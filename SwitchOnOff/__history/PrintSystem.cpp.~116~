void __fastcall TPrintForm::Timer1Timer(TObject *Sender)
{
	if(Printing)
		Print_Process();


	// 버튼 누르면 PrintButtonClick과 같게
	Input_CheckForPrint();

	if(Input_Data[1] || Input_Data[2])
		PrintButtonClick(NULL);
}
