#pragma region __스위치 입력받기__

int Card_7230;

void Io_InitForPrint()
{
	Card_7230 = -1; // 카드 -1(초기화 되지않음 표기)

	Card_7230 = Register_Card(PCI_7230, 0);    // 카드 값 0으로 초기화

	if(Card_7230 < 0){ // 값이 초기화 되지 않으면
		ShowMessage("카드 값이 초기화 되지 않았습니다.");
		return;
	}
}

void Input_CheckForPrint()
{
	U32 DIValue = 0x00;

	if(Card_7230 >= 0)
		DI_ReadPort(Card_7230, 0, &DIValue);

	for(int i = 0; i < MAX_INPUT_COUNT; i++)
	{
		if(DIValue & (0x01 << i))  // &은 둘다 참이어야 참(1) 반환, 비트 이동하면서 한자리씩 참인지 체크
			Input_Data[i] = true;
		else
			Input_Data[i] = false;
	}
}

#pragma endregion __스위치 입력받기__


#pragma region __프린트 작업__

void __fastcall TPrintForm::Print_Process()
{
	//
	switch(Print_Step)
	{
		case STEP_INIT:  // 초기화
			// 모델 오픈 확인
			// 바코드 스펙 기입 확인
			// 등등 없을 경우
			// Printing = false;
			// break;

			// 있는 경우

			Print_i = 0;
			Print_End = false;

			if(Print_Mode == ONE)
				Change_PrintStep(STEP_PRINT_ONE);
			else if(Print_Mode == SET)
				Change_PrintStep(STEP_PRINT_SET);
			else
				Change_PrintStep(STEP_PRINT_ONE);

			Print_Tick = GetTickCount();
			break;

		case STEP_PRINT_ONE: // 단일 출력
			if(!Print_End){
				Test_Barcode_Print();
				Print_End = true;
			}

			if(GetTickCount() - Print_Tick > Print_Time)
			{
				Change_PrintStep(STEP_END);
			}
			break;

		case STEP_PRINT_SET: // 다중 출력
			Test_Barcode_Print();
			Print_i++;

			if(Print_i == Print_Count)
				Print_End = true;
			else
				Print_End = false;

			Change_PrintStep(STEP_PRINT_SET_DELAY);
			break;

		case STEP_PRINT_SET_DELAY:
			if(GetTickCount() - Print_Tick > Print_Time)  // 환경 설정 시간만큼 대기
			{
				if(Print_End)
				{
					Change_PrintStep(STEP_END);
				}
				else
					Change_PrintStep(STEP_PRINT_SET);
			}
			break;

		case STEP_END:
			if(GetTickCount() - Print_Tick > DELAY_TIME)
			{
				if(GetTickCount() - Print_Tick > 300)
				{
					Printing = false;

					Timer1->Enabled = false;
				}
			}

			break;
	}
}

//  State 패턴을 통한 Print_Step 변경 및 그에 따른 적용
void Change_PrintStep(int PrintStep)
{
	Print_Step = PrintStep;
	Print_Tick = GetTickCount();
}

// 출력하기
void Test_Barcode_Print()
{
	Printing = false;

	PrintBarcode();
}

#pragma endregion __프린트 작업__

